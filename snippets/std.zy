template T
export interface Add
  public add -> T
    T lhs
    T rhs

template T
export interface Sub
  public sub -> T
    T lhs
    T rhs

template T
export interface IMul
  public imul -> T
    T lhs
    T rhs

template T
export interface IDiv
  public idiv -> T
    T lhs
    T rhs

export interface IArithmetic extends Add, Sub, IMul, IDiv

impl u8: IArithmetic
  add -> u8
    u8 lhs
    u8 rhs
  llvm ::
    %tmp1 = add u8 %lhs, %rhs
    ret u8 %tmp1

  sub -> u8
    u8 lhs
    u8 rhs
  llvm ::
    %tmp1 = sub u8 %lhs, %rhs
    ret u8 %tmp1

  imul -> u8
    u8 lhs
    u8 rhs
  llvm ::
    %tmp1 = imul u8 %lhs, %rhs
    ret u8 %tmp1

  idiv -> u8
    u8 lhs
    u8 rhs
  llvm ::
    %tmp1 = idiv u8 %lhs, %rhs
    ret u8 %tmp1

template T extends std::ops::Multiply
interface Double
  public double -> T
    &this

    this * 2

  public double_self -> T
    &mut this

    this |>= $.double()

test double
  mut f32 s := 40

  :: b := s.double()
  s = b

  s |>= $.double()
